
root = true

[*]
charset = utf-8
indent_style = space
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx}]
indent_size = 2

[*.{json,yaml,yml}]
indent_size = 2

[*.{html,htm,css}]
indent_size = 2

[*.{sh,bash}]
indent_size = 4
indent_style = tab

[*.md]
indent_size = 2
trim_trailing_whitespace = false
insert_final_newline = false
max_line_length = off
